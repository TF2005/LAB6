{
  "info": {
    "name": "Tasks API - Assignment 6",
    "description": "One request for every route of the Tasks API, plus the error cases (400 and 404). Run the requests in order: the POST request saves the new task id in the collection variable taskId, which the GET one, PUT and DELETE requests then reuse.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000" },
    { "key": "taskId", "value": "" }
  ],
  "item": [
    {
      "name": "1. Create a task (201)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 201', function () { pm.response.to.have.status(201); });",
              "pm.collectionVariables.set('taskId', pm.response.json()._id);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Finish Assignment 6\",\n  \"description\": \"Build the REST API with Express and MongoDB\",\n  \"status\": \"in-progress\",\n  \"priority\": \"high\",\n  \"dueDate\": \"2026-12-15\"\n}"
        },
        "url": { "raw": "{{baseUrl}}/tasks", "host": ["{{baseUrl}}"], "path": ["tasks"] }
      }
    },
    {
      "name": "2. List all tasks (200)",
      "event": [
        { "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Status is 200', function () { pm.response.to.have.status(200); });"] } }
      ],
      "request": {
        "method": "GET",
        "url": { "raw": "{{baseUrl}}/tasks", "host": ["{{baseUrl}}"], "path": ["tasks"] }
      }
    },
    {
      "name": "3. List tasks with a filter (200)",
      "event": [
        { "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Status is 200', function () { pm.response.to.have.status(200); });"] } }
      ],
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/tasks?status=in-progress&priority=high",
          "host": ["{{baseUrl}}"],
          "path": ["tasks"],
          "query": [
            { "key": "status", "value": "in-progress" },
            { "key": "priority", "value": "high" }
          ]
        }
      }
    },
    {
      "name": "4. Get one task (200)",
      "event": [
        { "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Status is 200', function () { pm.response.to.have.status(200); });"] } }
      ],
      "request": {
        "method": "GET",
        "url": { "raw": "{{baseUrl}}/tasks/{{taskId}}", "host": ["{{baseUrl}}"], "path": ["tasks", "{{taskId}}"] }
      }
    },
    {
      "name": "5. Update a task (200)",
      "event": [
        { "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Status is 200', function () { pm.response.to.have.status(200); });"] } }
      ],
      "request": {
        "method": "PUT",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Finish Assignment 6 (updated)\",\n  \"description\": \"Everything works, only the README is left\",\n  \"status\": \"done\",\n  \"priority\": \"medium\",\n  \"dueDate\": \"2026-12-10\"\n}"
        },
        "url": { "raw": "{{baseUrl}}/tasks/{{taskId}}", "host": ["{{baseUrl}}"], "path": ["tasks", "{{taskId}}"] }
      }
    },
    {
      "name": "6. Create with invalid data (400)",
      "event": [
        { "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Status is 400', function () { pm.response.to.have.status(400); });"] } }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"title\": \"\",\n  \"status\": \"finished\",\n  \"dueDate\": \"not-a-date\"\n}" },
        "url": { "raw": "{{baseUrl}}/tasks", "host": ["{{baseUrl}}"], "path": ["tasks"] }
      }
    },
    {
      "name": "7. Malformed JSON body (400)",
      "event": [
        { "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Status is 400', function () { pm.response.to.have.status(400); });"] } }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{ \"title\": \"Broken JSON\", }" },
        "url": { "raw": "{{baseUrl}}/tasks", "host": ["{{baseUrl}}"], "path": ["tasks"] }
      }
    },
    {
      "name": "8. Invalid id format (400)",
      "event": [
        { "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Status is 400', function () { pm.response.to.have.status(400); });"] } }
      ],
      "request": {
        "method": "GET",
        "url": { "raw": "{{baseUrl}}/tasks/abc", "host": ["{{baseUrl}}"], "path": ["tasks", "abc"] }
      }
    },
    {
      "name": "9. Task that does not exist (404)",
      "event": [
        { "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Status is 404', function () { pm.response.to.have.status(404); });"] } }
      ],
      "request": {
        "method": "GET",
        "url": { "raw": "{{baseUrl}}/tasks/000000000000000000000000", "host": ["{{baseUrl}}"], "path": ["tasks", "000000000000000000000000"] }
      }
    },
    {
      "name": "10. Delete a task (200)",
      "event": [
        { "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Status is 200', function () { pm.response.to.have.status(200); });"] } }
      ],
      "request": {
        "method": "DELETE",
        "url": { "raw": "{{baseUrl}}/tasks/{{taskId}}", "host": ["{{baseUrl}}"], "path": ["tasks", "{{taskId}}"] }
      }
    },
    {
      "name": "11. Delete the same task again (404)",
      "event": [
        { "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Status is 404', function () { pm.response.to.have.status(404); });"] } }
      ],
      "request": {
        "method": "DELETE",
        "url": { "raw": "{{baseUrl}}/tasks/{{taskId}}", "host": ["{{baseUrl}}"], "path": ["tasks", "{{taskId}}"] }
      }
    }
  ]
}
